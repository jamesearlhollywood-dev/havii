# HAVII environment variables
# Copy to .env.local for local development. Never commit secrets.

# Public Supabase project URL (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon key (safe for browser; RLS still enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: site URL used in auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVICE ROLE KEY — SERVER ONLY
# Never put SUPABASE_SERVICE_ROLE_KEY (or any service-role secret) in
# NEXT_PUBLIC_* variables. Never expose it to the browser or client bundles.
# If you need admin/ops scripts later, keep the service role in server-only
# env and use it exclusively in trusted server contexts.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# ---------------------------------------------------------------------------
