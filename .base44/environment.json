{
  "previewPort": 3000,
  "healthPath": "/",
  "startCommand": "docker compose -f docker-compose.base44.yml up -d",
  "secrets": [
    {
      "name": "NEXT_PUBLIC_SUPABASE_URL",
      "description": "Supabase project URL (Supabase → Settings → API)",
      "requiredAtBoot": false
    },
    {
      "name": "NEXT_PUBLIC_SUPABASE_ANON_KEY",
      "description": "Supabase anon public key (Supabase → Settings → API)",
      "requiredAtBoot": false
    }
  ]
}
